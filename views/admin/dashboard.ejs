<%- include('../partials/header') %>

<div class="page-header" style="padding: 100px 0 30px;">
    <div class="container">
        <h1><%= __('admin_dashboard') %></h1>
        <p><%= __('dashboard_welcome') %>, Admin</p>
    </div>
</div>

<main class="container" style="padding: 40px 20px; min-height: 50vh;">
    <div class="dashboard-grid">
        <!-- Sidebar -->
        <div class="sidebar-nav">
            <a href="/admin/dashboard" class="active"><i class="fa-solid fa-chart-pie"></i> Resumen</a>
            <a href="/admin/proyectos"><i class="fa-solid fa-file-alt"></i> <%= __('admin_projects') %></a>
            <a href="/auth/logout" style="color: #ef4444; border-top: 1px solid #eee; margin-top: 10px;"><i class="fa-solid fa-sign-out-alt"></i> <%= __('admin_logout') %></a>
        </div>
        
        <!-- Content -->
        <div class="dashboard-content">
            <h2 style="margin-bottom: 20px; color: var(--primary-dark);">Estadísticas Generales</h2>
            
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px;">
                <div class="dashboard-card" style="text-align: center; margin-bottom: 0;">
                    <i class="fa-solid fa-users" style="font-size: 2.5rem; color: var(--primary); margin-bottom: 10px;"></i>
                    <h3><%= totalUsers %></h3>
                    <p style="color: var(--text-secondary);"><%= __('admin_total_users') %></p>
                </div>
                <div class="dashboard-card" style="text-align: center; margin-bottom: 0;">
                    <i class="fa-solid fa-file-alt" style="font-size: 2.5rem; color: var(--primary); margin-bottom: 10px;"></i>
                    <h3><%= totalProjects %></h3>
                    <p style="color: var(--text-secondary);"><%= __('admin_total_projects') %></p>
                </div>
                <div class="dashboard-card" style="text-align: center; margin-bottom: 0;">
                    <i class="fa-solid fa-chalkboard-teacher" style="font-size: 2.5rem; color: var(--primary); margin-bottom: 10px;"></i>
                    <h3><%= totalSpeakers %></h3>
                    <p style="color: var(--text-secondary);"><%= __('admin_total_speakers') %></p>
                </div>
            </div>
            
            <div class="dashboard-card">
                <h3>Accesos Rápidos</h3>
                <div style="display: flex; gap: 15px; margin-top: 15px; flex-wrap: wrap;">
                    <a href="/admin/proyectos" class="btn-secondary"><i class="fa-solid fa-file-signature"></i> Revisar Proyectos</a>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/footer') %>
